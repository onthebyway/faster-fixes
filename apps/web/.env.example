DOMAIN_NAME="example.com"
BASE_URL=http://localhost:3000

DATABASE_URL="postgresql://username:password@host:5432/database_name?schema=public"
DATABASE_PROVIDER=postgres # Standard TCP PostgreSQL in every environment; use "neon" explicitly for Neon.

# ---------------------
# 
# AUTHENTICATION
# 
# ---------------------
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000 # Base URL of your app

# ---------------------
# 
# STRIPE
# 
# ---------------------
# Cloud-only. Leave unset for self-hosted deployments.
NEXT_PUBLIC_STRIPE_PUBLIC_KEY=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SIGNING_SECRET=
STRIPE_DEFAULT_TAX_RATE_ID=
PRO_MONTHLY_PRICE_ID=
PRO_YEARLY_PRICE_ID=
AGENCY_MONTHLY_PRICE_ID=
AGENCY_YEARLY_PRICE_ID=

# ---------------------
# 
# MAILER
# 
# ---------------------
MAILER_PROVIDER=smtp        # smtp | resend | plunk. Existing API-key-only configs still work when unset.
EMAIL_FROM=                # Full sender override, e.g. "FasterFixes <support@example.com>"
MAIL_FROM_DOMAIN=           # Optional verified domain, defaults to DOMAIN_NAME
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_SECURE=false           # true for implicit TLS on port 465
SMTP_REQUIRE_TLS=false      # Set true for production STARTTLS (normally port 587)
SMTP_USER=
SMTP_PASSWORD=
PLUNK_SECRET_KEY=
PLUNK_BASE_URL=https://next-api.useplunk.com # May point at self-hosted Plunk
RESEND_API_KEY=
RESEND_SEGMENT_ID=          # Optional marketing contacts; SMTP has no contact-management API

# ---------------------
# 
# STORAGE
# 
# ---------------------
STORAGE_PROVIDER=local      # local | s3 | r2. When unset, preserve legacy R2/AWS selection.
STORAGE_LOCAL_PATH=./storage # Persistent directory, only used by local storage
STORAGE_REGION=us-east-1
STORAGE_BUCKET_NAME=uploads
NEXT_PUBLIC_STORAGE_BASE_URL=/api/storage/uploads # Build-time public URL; for S3 use a bucket/CDN URL
STORAGE_ENDPOINT=           # S3-compatible HTTP(S) origin. Empty selects AWS S3.
STORAGE_FORCE_PATH_STYLE=true # Usually true for MinIO; false for virtual-host addressing

R2_ACCOUNT_ID=""
R2_ACCESS_KEY_ID=""
R2_SECRET_ACCESS_KEY=""

AWS_ACCESS_KEY_ID=""
AWS_BUCKET_NAME=""
AWS_SECRET_ACCESS_KEY=""
AWS_REGION=""

# ---------------------
#
# FEEDBACK WIDGET
#
# ---------------------
NEXT_PUBLIC_FF_API_KEY=""
NEXT_PUBLIC_FF_API_ORIGIN=http://localhost:3000

# ---------------------
#
# GITHUB APP
#
# ---------------------
GITHUB_APP_ID=
GITHUB_PRIVATE_KEY=          # Full PEM content with \n as literal newlines
GITHUB_WEBHOOK_SECRET=       # High-entropy random string for webhook signature verification

# ---------------------
#
# LINEAR INTEGRATION
#
# ---------------------
LINEAR_CLIENT_ID=
LINEAR_CLIENT_SECRET=
LINEAR_OAUTH_REDIRECT_URI=    # Optional override; defaults to $BETTER_AUTH_URL/api/linear/callback
LINEAR_WEBHOOK_SIGNING_SECRET= # App-level webhook secret from Linear's OAuth app settings
LINEAR_TOKEN_ENCRYPTION_KEY=   # 32-byte hex (generate via `openssl rand -hex 32`); rotation = full re-encrypt migration

# ---------------------
#
# SLACK INTEGRATION
#
# ---------------------
SLACK_CLIENT_ID=
SLACK_CLIENT_SECRET=
SLACK_TOKEN_ENCRYPTION_KEY=   # 32-byte hex (generate via `openssl rand -hex 32`); rotation = full re-encrypt migration

# ---------------------
#
# JIRA INTEGRATION
#
# ---------------------
JIRA_CLIENT_ID=
JIRA_CLIENT_SECRET=
JIRA_OAUTH_REDIRECT_URI=        # optional; falls back to BETTER_AUTH_URL/BASE_URL + /api/jira/callback
JIRA_TOKEN_ENCRYPTION_KEY=      # 32-byte hex (generate via `openssl rand -hex 32`); rotation = full re-encrypt migration
JIRA_WEBHOOK_BASE_URL=          # optional; public base URL Jira delivers webhooks to (use a tunnel locally), falls back to BETTER_AUTH_URL/BASE_URL


# ---------------------
#
# INNGEST
#
# ---------------------
INNGEST_BASE_URL=            # e.g. http://localhost:8288 for self-hosted Inngest; empty uses cloud
INNGEST_DEV=                 # 0 in production (including self-hosting), 1 for a local dev server
INNGEST_SERVE_ORIGIN=        # Optional internal app origin reachable by Inngest, e.g. http://app:3000
INNGEST_EVENT_KEY=           # Same event key configured on your Inngest server
INNGEST_SIGNING_KEY=         # Same hexadecimal signing key configured on your Inngest server

# ---------------------
#
# DEPLOYMENT MODE
#
# ---------------------
# Set to "true" on the official hosted version to enable marketing pages (home, pricing, blog, docs, legal).
# Self-hosted instances leave this unset or "false" — users are redirected straight to /login.
NEXT_PUBLIC_IS_CLOUD=false