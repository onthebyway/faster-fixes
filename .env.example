# Docker Compose configuration. Copy to .env and fill in every secret.
BASE_URL=http://localhost:3000
DOMAIN_NAME=localhost
BETTER_AUTH_SECRET=       # Generate: openssl rand -base64 32
POSTGRES_PASSWORD=       # Generate: openssl rand -hex 32 (URL-safe)
INNGEST_EVENT_KEY=        # Generate: openssl rand -hex 32
INNGEST_SIGNING_KEY=      # Generate: openssl rand -hex 32

# Default: persistent local storage. Public variables are baked into the image;
# rebuild the app after changing BASE_URL or NEXT_PUBLIC_STORAGE_BASE_URL.
STORAGE_PROVIDER=local
STORAGE_BUCKET_NAME=uploads
NEXT_PUBLIC_STORAGE_BASE_URL=/api/storage/uploads

# Configure your SMTP server and a verified sender address. No mail server is bundled.
MAILER_PROVIDER=smtp
EMAIL_FROM=               # e.g. "FasterFixes <support@example.com>"
SMTP_HOST=                # Required for SMTP, e.g. mail.example.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_REQUIRE_TLS=true
SMTP_USER=                # Set both credentials, or leave both empty for an unauthenticated relay.
SMTP_PASSWORD=

# Port 465 uses implicit TLS; set SMTP_SECURE=true.

# For S3-compatible storage (including self-hosted MinIO):
# STORAGE_PROVIDER=s3
# STORAGE_ENDPOINT=https://storage.example.com
# STORAGE_REGION=us-east-1
# STORAGE_FORCE_PATH_STYLE=true
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# NEXT_PUBLIC_STORAGE_BASE_URL=https://storage.example.com/uploads
# The endpoint must be reachable by browsers too, for direct uploads.

# Resend/Plunk are optional alternatives to SMTP:
# MAILER_PROVIDER=resend
# RESEND_API_KEY=
# MAILER_PROVIDER=plunk
# PLUNK_SECRET_KEY=
# PLUNK_BASE_URL=https://next-api.useplunk.com

# Optional tracker integrations: copy the corresponding variables from
# apps/web/.env.example. The app reads this .env through Compose's env_file.
